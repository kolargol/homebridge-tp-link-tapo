{
  "pluginAlias": "HomebridgeTPLinkTapo",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "description": "TPLink Tapo Platform"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "required": true,
        "description": "TPLink's account email."
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "TPLink's account password"
      },
      "addresses": {
        "title": "Addresses",
        "required": true,
        "uniqueItems": true,
        "type": "array",
        "description": "A list of IPs for each device",
        "items": {
          "title": "Ip Address",
          "type": "string"
        }
      },
      "pollingInterval": {
        "title": "Polling Interval (ms)",
        "type": "integer",
        "required": false,
        "default": 15000,
        "minimum": 5000,
        "maximum": 300000,
        "description": "How often to poll devices for state updates, in milliseconds. Lower values mean more responsive updates but higher network traffic. Default: 15000 (15 seconds)."
      }
    }
  }
}
